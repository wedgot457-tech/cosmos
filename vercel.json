{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/gateway.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/gateway?path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(assets|js)/(.*)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
